<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="rtl" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
      <TextView android:id="@+id/widgetCity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="بوجدور" android:textSize="14sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
      <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="4dp" android:src="@drawable/widget_location" android:contentDescription="المدينة" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
      <TextView android:id="@+id/widgetPrayerName" android:layout_width="0dp" android:layout_height="wrap_content" android:text="الفجر" android:textSize="22sp" android:textColor="#E5B558" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" android:textStyle="bold" android:gravity="center" />
      <TextView android:layout_width="1dp" android:layout_height="20dp" android:background="#4DFFFFFF" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
      <TextView android:id="@+id/widgetPrayerTime" android:layout_width="0dp" android:layout_height="wrap_content" android:text="05:34" android:textSize="22sp" android:textColor="#E5B558" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1.1" android:textStyle="bold" android:textDirection="ltr" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="3dp">
      <TextView android:id="@+id/widgetCaption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="متبقي" android:textSize="12sp" android:textColor="#EDF6F5" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" | " android:textColor="#4DFFFFFF" android:textSize="12sp" />
      <Chronometer android:id="@+id/widgetCountdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textDirection="ltr" android:textSize="12sp" android:textColor="#EDF6F5" android:includeFontPadding="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widgetTimesStrip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
      <LinearLayout android:id="@+id/widgetFajrRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_prayer_inactive" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginTop="3dp">
        <TextView android:id="@+id/widgetFajrLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:text="الفجر" android:textSize="12sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
        <TextView android:id="@+id/widgetFajr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:34" android:textSize="12sp" android:textColor="#E0E0E0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widgetDhuhrRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_prayer_inactive" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginTop="3dp">
        <TextView android:id="@+id/widgetDhuhrLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:text="الظهر" android:textSize="12sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
        <TextView android:id="@+id/widgetDhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12:50" android:textSize="12sp" android:textColor="#E0E0E0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widgetAsrRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_prayer_inactive" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginTop="3dp">
        <TextView android:id="@+id/widgetAsrLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:text="العصر" android:textSize="12sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
        <TextView android:id="@+id/widgetAsr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16:05" android:textSize="12sp" android:textColor="#E0E0E0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widgetMaghribRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_prayer_inactive" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginTop="3dp">
        <TextView android:id="@+id/widgetMaghribLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:text="المغرب" android:textSize="12sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
        <TextView android:id="@+id/widgetMaghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18:38" android:textSize="12sp" android:textColor="#E0E0E0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
      </LinearLayout>
      <LinearLayout android:id="@+id/widgetIshaRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_prayer_inactive" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginTop="3dp">
        <TextView android:id="@+id/widgetIshaLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:text="العشاء" android:textSize="12sp" android:textColor="#FFFFFF" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_weight="1" />
        <TextView android:id="@+id/widgetIsha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="19:46" android:textSize="12sp" android:textColor="#E0E0E0" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textDirection="ltr" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>